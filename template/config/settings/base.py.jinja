{% if use_redis %}
# --- django-tasks (RQ backend, via django-tasks-rq) ---
TASKS = {
    "default": {
        "BACKEND": "django_tasks_rq.RQBackend",
        "QUEUES": ["default"],
    }
}
RQ_QUEUES = {
    "default": {
        "URL": config("REDIS_URL", default="redis://redis:6379/0"),
    }
}
# django-tasks-rq ships a custom rq Job subclass that knows how to unwrap a
# django_tasks Task before calling it. django_rq's `rqworker` command (which is what
# actually runs the worker process) doesn't know about it unless told explicitly —
# either via this global RQ.JOB_CLASS setting or a `--job-class` flag on the CLI.
# Without this, the worker raises `TypeError: 'Task' object is not callable`.
RQ = {
    "JOB_CLASS": "django_tasks_rq.backend.Job",
}
{% else %}
# No Redis selected for this project: tasks run synchronously, in-process.
# This is fine for simple apps/prototypes, but blocks the request while the task
# runs. Re-run `copier update` (or regenerate) with use_redis=true to switch to the
# RQ-backed async backend if this becomes a bottleneck.
TASKS = {
    "default": {
        "BACKEND": "django_tasks.backends.immediate.ImmediateBackend",
    }
}
{% endif %}

