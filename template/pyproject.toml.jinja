[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
{% if author_name or author_email %}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
{% endif %}
requires-python = ">={{ python_version }}"
{% if open_source_license != "None" %}
{% set license_spdx = {
    "MIT": "MIT",
    "BSD-3-Clause": "BSD-3-Clause",
    "Apache-2.0": "Apache-2.0",
    "GNU GPLv3": "GPL-3.0-or-later",
    "GNU AGPLv3": "AGPL-3.0-or-later",
    "Proprietary": "LicenseRef-Proprietary",
}[open_source_license] %}
license = "{{ license_spdx }}"
license-files = ["LICENSE"]
{% endif %}
{% if project_type == 'reusable_app' %}
classifiers = [
    "Framework :: Django",
    "Framework :: Django :: 5.2",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
]
{% endif %}
dependencies = [
    "django>=5.2,<5.3",
{% if use_shinobi %}
    "django-shinobi",
{% endif %}
{% if project_type == 'full_project' %}
    "psycopg[binary]>=3",
    "python-decouple",
    "dj-database-url",
    "django-tasks",
{% if use_redis %}
    "django-tasks-rq",
    "redis",
{% endif %}
{% if use_shinobi %}
    "pyjwt",
{% endif %}
{% if use_async %}
    "uvicorn[standard]",
{% else %}
    "gunicorn",
{% endif %}
    "whitenoise",
{% endif %}
]

[project.optional-dependencies]
dev = [
    "pytest",
    "pytest-django",
    "pytest-cov",
{% if project_type == 'full_project' %}
    "model-bakery",
    "faker",
{% endif %}
    "pre-commit",
    "ruff",
    "pyright",
    "django-stubs",
]
{% if project_type == 'reusable_app' %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
{% else %}

[tool.uv]
package = false
{% endif %}

[tool.ruff]
target-version = "py{{ python_version.replace('.', '') }}"
line-length = 100
{% if project_type == 'reusable_app' %}
extend-exclude = ["migrations"]
{% else %}
extend-exclude = ["migrations", "typings"]
{% endif %}

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "DJ"]

[tool.pyright]
{% if project_type == 'reusable_app' %}
include = ["src", "tests"]
{% else %}
include = ["config", "apps"]
{% endif %}
exclude = ["**/migrations", "**/__pycache__"]
pythonVersion = "{{ python_version }}"
typeCheckingMode = "basic"
reportMissingImports = true
venvPath = "."
venv = ".venv"

[tool.pytest.ini_options]
{% if project_type == 'reusable_app' %}
DJANGO_SETTINGS_MODULE = "tests.settings"
{% else %}
DJANGO_SETTINGS_MODULE = "config.settings.test"
{% endif %}
python_files = ["tests.py", "test_*.py", "*_tests.py"]
{% if project_type == 'reusable_app' %}
addopts = "--cov=src --cov-report=term-missing"
{% else %}
addopts = "--cov=apps --cov-report=term-missing"
{% endif %}
