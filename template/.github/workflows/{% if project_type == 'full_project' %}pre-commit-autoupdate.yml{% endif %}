# Run pre-commit autoupdate nightly and open a PR if anything changed.
name: Pre-commit auto-update

on:
  schedule:
    - cron: "15 2 * * *"
  workflow_dispatch: # to trigger manually

permissions:
  contents: read

jobs:
  auto-update:
    permissions:
      contents: write # for peter-evans/create-pull-request to create a branch
      pull-requests: write # for peter-evans/create-pull-request to create a PR

    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1

      - name: Install uv
        uses: astral-sh/setup-uv@v10.1.0

      - name: Autoupdate pre-commit config
        run: uv tool run pre-commit autoupdate

      - name: Create Pull Request
        uses: peter-evans/create-pull-request@v8.1.1
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          branch: update/pre-commit-autoupdate
          title: Auto-update pre-commit hooks
          commit-message: Auto-update pre-commit hooks
          body: Update versions of tools in the pre-commit config to latest version
