# Copy to docker-compose.override.yml for local development.
# docker-compose automatically merges this file in.

services:
    web:
        build:
            target: builder
        command: ["python", "manage.py", "runserver", "0.0.0.0:8000"]
        volumes:
            - .:/app
        environment:
            DJANGO_SETTINGS_MODULE: config.settings.dev
{% if use_caddy %}
        # Caddy's automatic HTTPS needs a real public domain and inbound
        # 80/443, neither of which exist on a dev machine, so it'll just sit
        # here retrying certificate issuance in the background — harmless,
        # but ignorable. Hit the app directly instead:
        ports:
            - "8000:8000"
{% endif %}
{% if use_redis %}
    worker:
        volumes:
            - .:/app
        environment:
            DJANGO_SETTINGS_MODULE: config.settings.dev
{% endif %}
{% if use_vite %}
    vite:
        image: node:22-slim
        working_dir: /app
        command: sh -c "npm install && npm run dev -- --host 0.0.0.0"
        volumes:
            - .:/app
            - vite_node_modules:/app/node_modules
        ports:
            - "5173:5173"
{% endif %}
{% if use_vite %}

volumes:
    vite_node_modules:
{% endif %}
