from .base import *  # noqa: F401,F403

DEBUG = False

PASSWORD_HASHERS = ["django.contrib.auth.hashers.MD5PasswordHasher"]

# Tasks run inline/synchronously during tests — no Redis dependency in CI.
{% if task_backend == 'huey' %}
DJANGO_HUEY = {
    "default": "default",
    "queues": {
        "default": {
            "huey_class": "huey.RedisHuey",
            "immediate": True,
        },
    },
}
{% else %}
TASKS = {
    "default": {
        "BACKEND": "django_tasks.backends.immediate.ImmediateBackend",
    }
}
{% endif %}

# Captured in django.core.mail.outbox instead of sent — no mailpit dependency in CI.
EMAIL_BACKEND = "django.core.mail.backends.locmem.EmailBackend"
{% if use_rate_limiting %}

# Same reasoning as TASKS above: no Redis dependency in CI, and disabled by
# default so unrelated tests don't trip each other's rate limit by sharing
# state - the one test that exercises this explicitly re-enables it via
# @override_settings(RATELIMIT_ENABLE=True).
CACHES = {
    "default": {
        "BACKEND": "django.core.cache.backends.locmem.LocMemCache",
    }
}
RATELIMIT_ENABLE = False
{% endif %}
