# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/app
{% if use_redis %}
# Redis / tasks
REDIS_URL=redis://redis:6379/0
{% endif %}
{% if use_shinobi %}
# JWT
JWT_SIGNING_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

{% endif %}
# Email (defaults: localhost:1025 for non-Docker runs; docker-compose overrides the
# host to the mailpit service, whose web UI is at localhost:8025)
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=1025

# Production email (django-anymail; only read when
# DJANGO_SETTINGS_MODULE=config.settings.prod — not used locally with mailpit)
{% if email_provider == 'ses' %}
# Amazon SES: boto3 reads AWS credentials/region via its standard chain, so these
# are only needed if not already configured elsewhere (e.g. an IAM role).
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me
# AWS_DEFAULT_REGION=us-east-1
{% elif email_provider == 'postmark' %}
# ANYMAIL_POSTMARK_SERVER_TOKEN=change-me
{% elif email_provider == 'mailgun' %}
# ANYMAIL_MAILGUN_API_KEY=change-me
# ANYMAIL_MAILGUN_SENDER_DOMAIN=change-me
{% elif email_provider == 'sendgrid' %}
# ANYMAIL_SENDGRID_API_KEY=change-me
{% endif %}

# Static / whitenoise
DJANGO_STATIC_ROOT=/app/staticfiles
{% if use_vite %}

# Vite (defaults: dev_mode follows DJANGO_DEBUG, dev server at localhost:5173)
# DJANGO_VITE_DEV_MODE=True
# DJANGO_VITE_DEV_SERVER_HOST=localhost
# DJANGO_VITE_DEV_SERVER_PORT=5173
{% endif %}
