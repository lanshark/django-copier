def test_index_renders(client):
    response = client.get("/")
    assert response.status_code == 200
{% if use_allauth %}


def test_index_shows_login_link_when_anonymous(client):
    response = client.get("/")
    assert b'href="/accounts/login/"' in response.content


def test_index_shows_logged_in_user(client, django_user_model):
    user = django_user_model.objects.create_user(
        **{django_user_model.USERNAME_FIELD: "person@example.com"}, password="pw"
    )
    client.force_login(user)
    response = client.get("/")
    content = response.content.decode()
    assert "Logged in user:" in content
    assert 'href="/accounts/logout/"' in content
{% endif %}
