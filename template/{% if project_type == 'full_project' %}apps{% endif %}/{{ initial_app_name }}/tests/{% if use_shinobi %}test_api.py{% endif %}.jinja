{% set identifier_value = 'scott@example.com' if user_identifier == 'email' else 'scott' %}
import pytest
{% if use_rate_limiting %}
from django.core.cache import cache
from django.test import override_settings
{% endif %}
from model_bakery import baker

pytestmark = pytest.mark.django_db


def test_health(client):
    response = client.get("/api/v1/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_token_and_me(client):
    user = baker.make("accounts.User", {{ user_identifier }}="{{ identifier_value }}")
    user.set_password("s3cret-pw")
    user.save()

    resp = client.post(
        "/api/v1/auth/token",
        data={"{{ user_identifier }}": "{{ identifier_value }}", "password": "s3cret-pw"},
        content_type="application/json",
    )
    assert resp.status_code == 200
    access = resp.json()["access"]

    me_resp = client.get(
        "/api/v1/me",
        headers={"Authorization": f"Bearer {access}"},
    )
    assert me_resp.status_code == 200
    assert me_resp.json()["{{ user_identifier }}"] == "{{ identifier_value }}"
{% if use_rate_limiting %}


@override_settings(RATELIMIT_ENABLE=True)
def test_obtain_token_rate_limited(client):
    """5 attempts/minute per IP on /auth/token - the 6th in the same
    window gets rejected. RATELIMIT_ENABLE is False by default in tests
    (see config/settings/test.py) so unrelated tests don't trip each
    other's shared budget; re-enabled here just for this one test.
    """
    cache.clear()
    baker.make("accounts.User", {{ user_identifier }}="{{ identifier_value }}")

    for _ in range(5):
        resp = client.post(
            "/api/v1/auth/token",
            data={"{{ user_identifier }}": "{{ identifier_value }}", "password": "wrong"},
            content_type="application/json",
        )
        assert resp.status_code == 401

    resp = client.post(
        "/api/v1/auth/token",
        data={"{{ user_identifier }}": "{{ identifier_value }}", "password": "wrong"},
        content_type="application/json",
    )
    assert resp.status_code == 429
{% endif %}
