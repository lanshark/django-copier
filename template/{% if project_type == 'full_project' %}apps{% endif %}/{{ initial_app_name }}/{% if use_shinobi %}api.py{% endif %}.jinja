from django.contrib.auth import authenticate
{% if use_rate_limiting %}
from django_ratelimit.core import is_ratelimited
{% endif %}
from ninja import NinjaAPI

from .auth import JWTAuth, make_access_token, make_refresh_token
from .schemas import HealthOut, TokenObtainIn, TokenPairOut
from .tasks import example_background_task

api = NinjaAPI(title="{{ project_name }} API", version="1.0.0")


@api.get("/health", response=HealthOut, auth=None)
def health(request):
    return {"status": "ok"}


@api.post("/auth/token", response=TokenPairOut, auth=None)
def obtain_token(request, payload: TokenObtainIn):
{% if use_rate_limiting %}
    # Shares a budget with Strawberry's obtainToken (same group/key), so
    # switching API doesn't let an attacker dodge the limit.
    if is_ratelimited(request, group="auth-token", key="ip", rate="5/m", increment=True):
        return api.create_response(request, {"detail": "Too many requests"}, status=429)
{% endif %}
{% if user_identifier == 'email' %}
    # ModelBackend's `authenticate()` kwarg is always named `username`, regardless
    # of AUTH_USER_MODEL.USERNAME_FIELD — it's mapped internally, so this is correct.
{% endif %}
    user = authenticate(request, username=payload.{{ user_identifier }}, password=payload.password)
    if user is None:
        return api.create_response(request, {"detail": "Invalid credentials"}, status=401)
    return {
        "access": make_access_token(user),
        "refresh": make_refresh_token(user),
    }


@api.get("/me", auth=JWTAuth())
def me(request):
    return {"id": request.user.pk, "{{ user_identifier }}": request.user.{{ user_identifier }}}


@api.post("/example-task", auth=JWTAuth())
def trigger_example_task(request):
{% if task_backend == 'huey' %}
    """Demonstrates enqueuing a task onto the Huey backend."""
    result = example_background_task(request.user.pk, request.request_id)
    # huey's return type is Optional[Result] only because results-storage
    # could be disabled; DJANGO_HUEY never disables it, so this always holds.
    assert result is not None
{% else %}
    """Demonstrates enqueuing a django-tasks job onto the RQ backend."""
    result = example_background_task.enqueue(request.user.pk, request.request_id)
{% endif %}
    return {"task_id": str(result.id)}
