services:
    db:
        image: postgres:{{ postgres_version }}
        environment:
            POSTGRES_DB: app
            POSTGRES_USER: postgres
            POSTGRES_PASSWORD: postgres
        volumes:
            - postgres_data:/var/lib/postgresql/data
        healthcheck:
            test: ["CMD-SHELL", "pg_isready -U postgres"]
            start_period: 5s
            interval: 5s
            timeout: 5s
            retries: 5
{% if use_redis %}
    redis:
        image: redis:7-alpine
        volumes:
            - redis_data:/data
{% endif %}
    mailpit:
        # Dev-only SMTP catcher: web/worker send mail to it instead of a real relay.
        # Web UI at http://localhost:8025 shows everything sent.
        image: axllent/mailpit:v1.31
        healthcheck:
            test: ["CMD", "/mailpit", "readyz"]
            interval: 15s
            timeout: 5s
            retries: 5
            start_period: 10s
            start_interval: 1s
        ports:
            - "127.0.0.1:8025:8025"
            - "127.0.0.1:1025:1025"
    web:
        build:
            context: .
            dockerfile: docker/Dockerfile
        env_file:
            - .env
            - docker/mailpit.env
        depends_on:
            db:
                condition: service_healthy
            mailpit:
                condition: service_healthy
{% if use_redis %}
            redis:
                condition: service_started
{% endif %}
{% if use_caddy %}
        # A fixed, project-unique name so the standalone Caddy compose
        # project (docker-compose.caddy.yml) can reach this container by
        # name over the shared caddy_net network - "web" alone would
        # collide with every other project generated from this template
        # that also joins caddy_net. Must match the Caddyfile's upstream.
        container_name: {{ project_slug }}-web
        networks:
            - default
            - caddy_net
{% else %}
        ports:
            - "8000:8000"
{% endif %}
{% if use_redis %}
    # Redis-backed worker service (only rendered when use_redis=true).
    worker:
        build:
            context: .
            dockerfile: docker/Dockerfile
{% if task_backend == 'huey' %}
        # Also runs the scheduler for @db_periodic_task-decorated tasks, and
        # autoloads tasks.py on startup (both are the djangohuey default).
        command: ["python", "manage.py", "djangohuey", "--queue", "default"]
{% else %}
        # --job-class is redundant with the RQ.JOB_CLASS setting in base.py, but kept
        # explicit here since it's easy to lose track of when copy-pasting this command.
        command: ["python", "manage.py", "rqworker", "default", "--job-class", "django_tasks_rq.backend.Job"]
{% endif %}
        env_file:
            - .env
            - docker/mailpit.env
        depends_on:
            db:
                condition: service_healthy
            mailpit:
                condition: service_healthy
            redis:
                condition: service_started
{% endif %}
volumes:
    postgres_data:
{% if use_redis %}
    redis_data:
{% endif %}
{% if use_caddy %}

# caddy_net is created and owned by docker-compose.caddy.yml (or by `docker
# network create caddy_net` directly, if Caddy is managed outside this
# project entirely) - declared here as external so `web` can join it.
networks:
    default: {}
    caddy_net:
        external: true
{% endif %}
