services:
  db:
    image: postgres:17
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
{% if use_redis %}
  redis:
    image: redis:7-alpine
    volumes:
      - redis_data:/data
{% endif %}
  mailpit:
    # Dev-only SMTP catcher: web/worker send mail to it instead of a real relay.
    # Web UI at http://localhost:8025 shows everything sent.
    image: axllent/mailpit:v1.31
    ports:
      - "127.0.0.1:8025:8025"
      - "127.0.0.1:1025:1025"
  web:
    build:
      context: .
      dockerfile: docker/Dockerfile
    env_file:
      - .env
      - docker/mailpit.env
    depends_on:
      db:
        condition: service_healthy
      mailpit:
        condition: service_started
{% if use_redis %}
      redis:
        condition: service_started
{% endif %}
    ports:
      - "8000:8000"
{% if use_redis %}
  # Redis-backed worker service (only rendered when use_redis=true).
  worker:
    build:
      context: .
      dockerfile: docker/Dockerfile
    # --job-class is redundant with the RQ.JOB_CLASS setting in base.py, but kept
    # explicit here since it's easy to lose track of when copy-pasting this command.
    command: ["python", "manage.py", "rqworker", "default", "--job-class", "django_tasks_rq.backend.Job"]
    env_file:
      - .env
      - docker/mailpit.env
    depends_on:
      db:
        condition: service_healthy
      mailpit:
        condition: service_started
      redis:
        condition: service_started
{% endif %}
volumes:
  postgres_data:
{% if use_redis %}
  redis_data:
{% endif %}
