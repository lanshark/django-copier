services:
    db:
        image: postgres:{{ postgres_version }}
        environment:
            POSTGRES_DB: app
            POSTGRES_USER: postgres
            POSTGRES_PASSWORD: postgres
        volumes:
            - postgres_data:/var/lib/postgresql/data
        healthcheck:
            test: ["CMD-SHELL", "pg_isready -U postgres"]
            start_period: 5s
            interval: 5s
            timeout: 5s
            retries: 5
{% if use_redis %}
    redis:
        image: redis:7-alpine
        volumes:
            - redis_data:/data
{% endif %}
    mailpit:
        # Dev-only SMTP catcher: web/worker send mail to it instead of a real relay.
        # Web UI at http://localhost:8025 shows everything sent.
        image: axllent/mailpit:v1.31
        healthcheck:
            test: ["/mailpit", "readyz"]
            interval: 15s
            timeout: 5s
            retries: 5
            start_period: 10s
            start_interval: 1s
        ports:
            - "127.0.0.1:8025:8025"
            - "127.0.0.1:1025:1025"
{% if use_caddy %}
    caddy:
        image: caddy:2-alpine
        restart: unless-stopped
        ports:
            - "80:80"
            - "443:443"
        volumes:
            - ./Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy_data:/data
            - caddy_config:/config
        depends_on:
            - web
{% endif %}
{% if use_log_shipping %}
    vector:
        image: timberio/vector:0.60.0-alpine
        restart: unless-stopped
        volumes:
            - /var/run/docker.sock:/var/run/docker.sock:ro
            - ./vector.yaml:/etc/vector/vector.yaml:ro
            - vector_data:/var/lib/vector
        environment:
            # Required for vector.yaml's ${VICTORIALOGS_*} references to resolve -
            # Vector disables env var interpolation by default now.
            VECTOR_DANGEROUSLY_ALLOW_ENV_VAR_INTERPOLATION: "true"
        env_file:
            - .env
{% endif %}
    web:
        build:
            context: .
            dockerfile: docker/Dockerfile
        env_file:
            - .env
            - docker/mailpit.env
        depends_on:
            db:
                condition: service_healthy
            mailpit:
                condition: service_healthy
{% if use_redis %}
            redis:
                condition: service_started
{% endif %}
{% if not use_caddy %}
        ports:
            - "8000:8000"
{% endif %}
{% if use_redis %}
    # Redis-backed worker service (only rendered when use_redis=true).
    worker:
        build:
            context: .
            dockerfile: docker/Dockerfile
        # --job-class is redundant with the RQ.JOB_CLASS setting in base.py, but kept
        # explicit here since it's easy to lose track of when copy-pasting this command.
        command: ["python", "manage.py", "rqworker", "default", "--job-class", "django_tasks_rq.backend.Job"]
        env_file:
            - .env
            - docker/mailpit.env
        depends_on:
            db:
                condition: service_healthy
            mailpit:
                condition: service_healthy
            redis:
                condition: service_started
{% endif %}
volumes:
    postgres_data:
{% if use_caddy %}
    caddy_data:
    caddy_config:
{% endif %}
{% if use_log_shipping %}
    vector_data:
{% endif %}
{% if use_redis %}
    redis_data:
{% endif %}
